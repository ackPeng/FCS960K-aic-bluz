export DEB_CFLAGS_MAINT_APPEND = -pthread

# Cross-compiler environment
export CC = aarch64-linux-gnu-gcc
export CXX = aarch64-linux-gnu-g++
export LD = aarch64-linux-gnu-ld
export AR = aarch64-linux-gnu-ar
export RANLIB = aarch64-linux-gnu-ranlib
export STRIP = aarch64-linux-gnu-strip

# PKG_CONFIG for cross-compilation
export PKG_CONFIG_PATH =
export PKG_CONFIG_LIBDIR = /usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
export PKG_CONFIG_SYSROOT_DIR = /

# Configure flags for bluez cross-compilation
CONFFLAGS = \
	--prefix=/usr \
	--mandir=/usr/share/man \
	--sysconfdir=/etc \
	--localstatedir=/var \
	--enable-tools \
	--enable-experimental \
	--enable-deprecated \
	--enable-client \
	--enable-library \
	--disable-systemd \
	--disable-udev \
	--host=aarch64-linux-gnu \
	--build=x86_64-linux-gnu

override_dh_auto_configure:
	dh_auto_configure -- $(CONFFLAGS)

override_dh_auto_build:
	$(MAKE)

override_dh_auto_install:
	$(MAKE) DESTDIR=$(CURDIR)/debian/tmp install

override_dh_install:
	dh_install --sourcedir=debian/tmp
	dh_missing || true

override_dh_shlibdeps:
	dh_shlibdeps -l/usr/lib/aarch64-linux-gnu/

override_dh_makeshlibs:
	dh_makeshlibs -- -c0

# Output deb packages to output directory instead of parent directory
# (parent directory may not be writable in container environments)
override_dh_builddeb:
	dh_builddeb --destdir=$(CURDIR)/output -- -Zxz

# After all deb helpers run, copy files for dpkg-genbuildinfo
execute_after_dh_builddeb:
	for deb in output/*.deb; do \
		if [ -f "$$deb" ]; then \
			cp "$$deb" .. ; \
		fi; \
	done

execute_after_dh_genbuildinfo:
	# Remove the copied files from parent directory
	for deb in output/*.deb; do \
		if [ -f "$$deb" ]; then \
			rm -f ../$$(basename "$$deb") ; \
		fi; \
	done
