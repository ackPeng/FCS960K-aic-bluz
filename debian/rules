#!/usr/bin/make -f

# This file is auto generated by rsdk infra-package-update.
# DO NOT EDIT IT DIRECTLY!
# Custom rules should be placed in .github/local/rules.local

include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/architecture.mk
-include .github/local/rules.local

%:
	dh $@ $(EXTRA_DH_OPTIONS)

override_dh_auto_clean:
	# Skip autotools clean completely in cross-build environment
	# Just remove debian build artifacts
	dh_clean

override_dh_auto_build:
	$(MAKE)

override_dh_auto_install:
	$(MAKE) DESTDIR=$(CURDIR)/debian/tmp install

override_dh_builddeb:
	dh_builddeb --destdir=$(CURDIR)/output -- -Zxz
	# Copy deb files to parent directory for dpkg-genbuildinfo
	for deb in output/*.deb; do \
		if [ -f "$$deb" ]; then \
			cp "$$deb" .. ; \
		fi; \
	done

# Clean up copied files after dpkg-genbuildinfo
execute_after_dh_build:
	rm -f ../$(DEB_SOURCE)_*.deb
